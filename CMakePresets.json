{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 3,
        "patch": 0
    },

    "configurePresets": [

        {
            "name": "config-base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}"
        },

        {
            "name": "develop-base",
            "hidden": true,
            "cacheVariables": {
                "varerr_INSTALL": "ON",
                "varerr_TESTING": "ON",
                "varerr_DEVELOPMENT": "ON",
                "varerr_VENDORED_CATCH2": "ON",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },

        {
            "name": "tools-clang-tidy-mixin",
            "hidden": true,
            "cacheVariables": {
                "varerr_TESTING": "ON",
                "varerr_TESTING_CLANG_TIDY": "ON"
            }
        },
        {
            "name": "tools-iwyu-mixin",
            "hidden": true,
            "cacheVariables": {
                "varerr_TESTING": "ON",
                "varerr_TESTING_IWYU": "ON"
            }
        },

        {
            "name": "windows-base",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },

        {
            "name": "ninja-base-amd64",
            "hidden": true,
            "generator": "Ninja",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            }
        },
        {
            "name": "make-base-amd64",
            "hidden": true,
            "generator": "Unix Makefiles",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            }
        },

        {
            "name": "windows-ninja-msvc-amd64-dev",
            "displayName": "windows-ninja-msvc-amd64-dev",
            "inherits": [
                "config-base",
                "develop-base",
                "windows-base",
                "ninja-base-amd64"
            ],
            "toolset": {
                "value": "v145,host=x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "windows-ninja-clangcl-amd64-dev",
            "displayName": "windows-ninja-clangcl-amd64-dev",
            "inherits": [
                "config-base",
                "develop-base",
                "windows-base",
                "ninja-base-amd64"
            ],
            "toolset": {
                "value": "ClangCL,host=x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang-cl.exe"
            }
        },

        {
            "name": "linux-make-gcc-amd64-dev",
            "displayName": "linux-make-gcc-amd64-dev",
            "inherits": [
                "config-base",
                "develop-base",
                "linux-base",
                "make-base-amd64"
            ],
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "linux-make-clang-amd64-dev",
            "displayName": "linux-make-clang-amd64-dev",
            "inherits": [
                "config-base",
                "develop-base",
                "linux-base",
                "make-base-amd64"
            ],
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "linux-ninja-gcc-amd64-dev",
            "displayName": "linux-ninja-gcc-amd64-dev",
            "inherits": [
                "config-base",
                "develop-base",
                "linux-base",
                "ninja-base-amd64"
            ],
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "linux-ninja-clang-amd64-dev",
            "displayName": "linux-ninja-clang-amd64-dev",
            "inherits": [
                "config-base",
                "develop-base",
                "linux-base",
                "ninja-base-amd64"
            ],
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },

        {
            "name": "windows-ninja-msvc-amd64-dev-tools",
            "displayName": "windows-ninja-msvc-amd64-dev-tools",
            "inherits": [
                "windows-ninja-msvc-amd64-dev",
                "tools-clang-tidy-mixin"
            ]
        },
        {
            "name": "windows-ninja-clangcl-amd64-dev-tools",
            "displayName": "windows-ninja-clangcl-amd64-dev-tools",
            "inherits": [
                "windows-ninja-clangcl-amd64-dev",
                "tools-clang-tidy-mixin"
            ]
        },
        {
            "name": "linux-make-gcc-amd64-dev-tools",
            "displayName": "linux-make-gcc-amd64-dev-tools",
            "inherits": [
                "linux-make-gcc-amd64-dev",
                "tools-clang-tidy-mixin"
            ]
        },
        {
            "name": "linux-make-clang-amd64-dev-tools",
            "displayName": "linux-make-clang-amd64-dev-tools",
            "inherits": [
                "linux-make-clang-amd64-dev",
                "tools-clang-tidy-mixin",
                "tools-iwyu-mixin"
            ]
        },
        {
            "name": "linux-ninja-gcc-amd64-dev-tools",
            "displayName": "linux-ninja-gcc-amd64-dev-tools",
            "inherits": [
                "linux-ninja-gcc-amd64-dev",
                "tools-clang-tidy-mixin"
            ]
        },
        {
            "name": "linux-ninja-clang-amd64-dev-tools",
